# Copy to .env for local use. In GitHub Actions use Repository Secrets/Variables.
# Required Secrets: use NEW project credentials, never commit real values.
DEEPSEEK_API_KEY=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=

# Variables: the official API ID for DeepSeek V4.1 Flash is deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
FEISHU_RECEIVE_ID_TYPE=chat_id
# GitHub Actions only; enable after a successful manual send.
ENABLE_DAILY_PUSH=false

# Legacy group-only fallback. Leave empty for new configurations.
FEISHU_BOT_CHAT_ID=

# Optional Secrets for file ownership / custom archive folders.
FEISHU_ADMIN_OPEN_ID=
FEISHU_FOLDER_TOKEN=
FEISHU_ARCHIVE_ROOT_FOLDER_TOKEN=
FEISHU_SIX_COUNTRY_FOLDER_NAME=六国洞察报告

REQUIRE_FEISHU_DELIVERY=true
MONITOR_DESTINATION_TIER=production
MONITOR_RECEIPT_PATH=output/monitor/receipt.json
