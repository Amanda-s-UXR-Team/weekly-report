flowchart TD
    config["sources.yaml：36个已启用检索源、关键词、时效和权重"] --> entry["main_async：创建回执并加载配置"]
    entry --> rss["collect_all_sources → RSS并发采集"]
    rss --> item["RSSCollector：发现线索、清洗摘要、构造NewsItem"]
    item --> pre["process_items：URL/标题去重、时效与七国范围过滤；每类最多20条"]
    pre --> resolve["enrich_original_articles：解析Google News到发布网站"]
    resolve --> extract["抓取发布页HTML/PDF并提取原文；正文至少300字符"]
    extract --> fulltext{"存在可读原文？"}
    fulltext -->|"否"| stop["停止发送，运行失败"]
    fulltext -->|"是"| semantic["DeepSeek语义去重：识别同一事件"]
    secrets["Secrets：DeepSeek Key；Variables：模型和API地址"] --> client["DeepSeekSummarizer：5路并发、JSON输出"]
    client -.-> semantic
    client -.-> ai
    semantic --> ai["DeepSeek读取原文：相关性、国家、分类、评分、三段式中文摘要"]
    ai --> filter["process_and_filter_items：剔除低于7分、弱相关或证据不足条目"]
    filter --> final["finalize_categories + limit_total_items：全局排序；目标3条、最多5条"]
    final --> nonempty{"至少1条合格资讯？"}
    nonempty -->|"否"| stop
    nonempty -->|"是"| highlights["generate_daily_highlights：复用原文摘要，结构化展示最多3条今日要点"]
    final --> html["EmailSender.render_email：完整资讯与来源附录"]
    highlights --> gate{"鉴权正常且有成功AI调用？"}
    gate -->|"是"| html
    gate -->|"否"| stop
    html --> pdf["generate_pdf：WeasyPrint生成A4 PDF"]
    pdf --> archive{"配置了归档根目录？"}
    archive -->|"是"| routed["日报子目录：上传、授权"]
    archive -->|"否"| direct["直接上传到配置目录或应用默认位置"]
    routed -.->|"归档异常时回退"| direct
    routed --> owner["将PDF所有者移交给周馨；机器人保留管理权限；重新读取元数据验证"]
    direct --> owner
    owner -->|"失败"| stop
    owner -->|"成功"| card["send_digest_card：今日要点与PDF链接"]
    card --> receipt["记录API确认或异常 → receipt.json"]
    receipt --> finish["本地登记清理；检查必需发送确认"]
